# Supabase project → Settings → API. The publishable (anon) key is safe in the browser:
# every table is protected by row-level security (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only (API and billing routes). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: the mobile-money provider name once one is implemented (src/lib/server/payments.ts).
# PAYMENT_PROVIDER=
# ---- Email (Resend). All server-only except the two NEXT_PUBLIC_ values. Checked at boot (src/lib/server/env.ts).
# Full-access API key (Resend → API Keys). Missing = email features answer 503.
RESEND_API_KEY=
# Signing secret of the webhook pointing at /api/webhooks/resend (event: inbox.email.received).
RESEND_WEBHOOK_SECRET=
# Inbox id of estamp@workwithignas.com (Resend → Inboxes). Webhook events from other inboxes are ignored.
RESEND_ESTAMP_INBOX_ID=
# Every email is sent from this inbox address, so replies land in its threads.
EMAIL_FROM="eStamp <estamp@workwithignas.com>"
# Where new-inbound and contact-form notifications go.
EMAIL_ADMIN_NOTIFY=
# Deployed URL: absolute links and email images (public/email/*.png) use it.
NEXT_PUBLIC_APP_URL=
# Cloudflare Turnstile for the contact form. Missing = the form is off.
# Local testing: Cloudflare's always-pass test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
