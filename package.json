    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
